{#
    Das Template verwendet eine flache Block-Struktur, um die Erweiterbarkeit im Contao Template Studio zu maximieren.
    Jeder Block kann einzeln überschrieben werden. Wichtig: Definieren Sie Blöcke in Ihrem Kind-Template
    immer auf der obersten Ebene (nicht innerhalb anderer Blöcke verschachtelt).
#}
{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    {% set container_attributes = attrs().addClass('dc-equipment-listing').mergeWith(container_attributes|default) %}
    <div{{ container_attributes }}>
        {{ block('listing_items') }}
    </div>
{% endblock %}

{% block listing_items %}
    {% if items is defined and items|length %}
        {% set list_attributes = attrs().addClass('equipment-items').mergeWith(list_attributes|default) %}
        <ul{{ list_attributes }}>
            {% for item in items %}
                {{ block('listing_item') }}
            {% endfor %}
        </ul>
    {% else %}
        {{ block('no_items') }}
    {% endif %}
{% endblock %}

{% block listing_item %}
    {% set item_attributes = attrs().addClass('equipment-item').mergeWith(item_attributes|default) %}
    <li{{ item_attributes }}>
        {{ block('item_title') }}
        {{ block('item_details') }}
        {{ block('item_description') }}
    </li>
{% endblock %}

{% block item_details %}
    <dl class="equipment-details">
        <dt>Art</dt>
        <dd>{{ item.type }}{% if item.subType %} – {{ item.subType }}{% endif %}</dd>
        {% if item.manufacturer or item.model %}
            <dt>Hersteller / Modell</dt>
            <dd>{{ item.manufacturer }}{% if item.model %} {{ item.model }}{% endif %}</dd>
        {% endif %}
        {% if item.size %}
            <dt>Größe</dt>
            <dd>{{ item.size }}</dd>{% endif %}
        {% if item.color %}
            <dt>Farbe</dt>
            <dd>{{ item.color }}</dd>{% endif %}
        <dt>Leihgebühr</dt>
        <dd>{{ item.rentalFee|number_format(2, ',', '.') }} €</dd>
    </dl>
{% endblock %}

{% block item_title %}
    <strong>{{ item.title|default(item.name|default('')) }}</strong>
{% endblock %}

{% block item_description %}
    {% if item.description is defined and item.description %}
        <div class="description">{{ item.description|raw }}</div>
    {% endif %}
{% endblock %}

{% block no_items %}
    <p>Keine Ausrüstung gefunden.</p>
{% endblock %}
